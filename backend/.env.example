# Copy this file to .env and fill in real values. Never commit .env.
# PostgreSQL connection (psycopg v3 driver). Username provided: shakibalarman
DATABASE_URL=postgresql+psycopg://shakibalarman:CHANGE_ME@localhost:5432/sms_db

# JWT
JWT_SECRET_KEY=CHANGE_ME_generate_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=School Management System
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
